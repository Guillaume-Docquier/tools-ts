{
  "name": "@guillaume-docquier/tools-ts",
  "version": "0.0.0-semantically-released",
  "description": "My personal collection of typescript tools",
  "homepage": "https://github.com/Guillaume-Docquier/tools-ts",
  "license": "MIT",
  "author": "Guillaume Docquier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guillaume-Docquier/tools-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry.tools-ts.d.ts",
      "import": "./dist/entry.tools-ts.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "checks": "pnpm lint:fix && pnpm format:fix && pnpm typecheck && pnpm test --run",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "prepublishOnly": "pnpm i",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@logtape/logtape": "^2.1.1",
    "@logtape/redaction": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.54.0",
    "semantic-release": "^25.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{md,json,yml,yaml,css,scss}": "oxfmt",
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
