{
  "name": "@guillaume-docquier/tools-ts",
  "version": "0.0.0-semantically-released",
  "description": "My personal collection of typescript tools",
  "homepage": "https://github.com/Guillaume-Docquier/tools-ts",
  "license": "MIT",
  "author": "Guillaume Docquier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guillaume-Docquier/tools-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry.tools-ts.d.ts",
      "import": "./dist/entry.tools-ts.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "checks": "pnpm lint:fix && pnpm format:fix && pnpm typecheck && pnpm test --run",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@logtape/logtape": "^2.2.3",
    "@logtape/redaction": "^2.2.3"
  },
  "devDependencies": {
    "@guillaume-docquier/oxfmt": "^1.0.0",
    "@guillaume-docquier/oxlint": "^1.1.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.9",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "semantic-release": "^25.0.5",
    "typescript": "~7.0.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{md,json,yml,yaml,css,scss}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.5.0",
      "onFail": "download"
    }
  }
}
