{
  "name": "@guillaume-docquier/tools-ts",
  "version": "0.0.0-semantically-released",
  "description": "My personal collection of typescript tools",
  "homepage": "https://github.com/Guillaume-Docquier/tools-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guillaume-Docquier/tools-ts.git"
  },
  "license": "MIT",
  "author": "Guillaume Docquier",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/entry.tools-ts.d.ts",
      "import": "./dist/entry.tools-ts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "format": "prettier --check . && pnpm format:package-json --check",
    "format:fix": "prettier --write --list-different . && pnpm format:package-json",
    "format:package-json": "sort-package-json package.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint -- --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "prepublishOnly": "pnpm i",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "lint-staged": {
    "*package.json": "sort-package-json",
    "*.{md,json,yml,yaml,css,scss}": "prettier --write",
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 140,
    "semi": false
  },
  "dependencies": {
    "@logtape/logtape": "^2.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "sort-package-json": "^3.6.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
