{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",

    // Somehow I need "dom" for structuredClone, even though it is supported in browser and node
    "lib": ["esnext", "dom"],
    // It doesn't run in node but we offer some node functions
    "types": ["node"],

    "useDefineForClassFields": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "esModuleInterop": true,

    /* Linting */
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true
  }
}
