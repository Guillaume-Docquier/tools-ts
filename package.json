{
  "name": "@guillaume-docquier/tools-ts",
  "version": "0.0.0-semantically-released",
  "description": "My personal collection of typescript tools",
  "homepage": "https://github.com/Guillaume-Docquier/tools-ts",
  "license": "MIT",
  "author": "Guillaume Docquier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guillaume-Docquier/tools-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/entry.tools-ts.d.ts",
      "import": "./dist/entry.tools-ts.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "checks": "pnpm lint:fix && pnpm format:fix && pnpm typecheck && pnpm test --run",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@logtape/logtape": "^2.2.3",
    "@logtape/redaction": "^2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.9",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.54.0",
    "semantic-release": "^25.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{md,json,yml,yaml,css,scss}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.4.0",
      "onFail": "download"
    }
  }
}
